# ===========================================
# Prolora Environment Variables
# Copy to .env.local and fill in values
# ===========================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Token Encryption (AES-256-GCM) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY_V2=
# Keep V1 key after rotation until migration is complete
# TOKEN_ENCRYPTION_KEY_V1=

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Reddit API (Application-Only, for Schicht D Discovery) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- OAuth: LinkedIn ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- OAuth: X/Twitter ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- OAuth: Mastodon ---
# Per-instance registration, no global credentials needed

# --- Email (Resend) ---
RESEND_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
OAUTH_STATE_SECRET=
